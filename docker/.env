# WAHA (WhatsApp HTTP API) - autenticacao
# Chave usada no header "X-Api-Key" das chamadas HTTP (tambem no dashboard: Servers -> API Key)
WHATSAPP_API_KEY=stm-b579c2f68d03ae14

# Engine (WEBJS, WPP, GOWS, NOWEB) - sessao fica em /app/.sessions
WHATSAPP_ENGINE=NOWEB

# Dashboard (acesso em http://localhost:3000/dashboard)
# ATENCAO: senhas comuns como "admin"/"waha"/"123" sao substituidas por uma aleatoria a cada start
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=studiomany2026

# Nome da sessao padrao (usado no body "session" das chamadas da API)
WHATSAPP_SESSION_NAME=default

# Swagger (acesso em http://localhost:3000/swagger) - protege a documentacao da API
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=studiomany2026

# Nao imprime o QR Code no console (o QR fica no dashboard)
WAHA_PRINT_QR=False

# Fuso horario do container
TZ=America/Sao_Paulo